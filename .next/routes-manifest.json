{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/competitions/[id]",
      "regex": "^/competitions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/competitions/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/analytics",
      "regex": "^/analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/analytics(?:/)?$"
    },
    {
      "page": "/competitions",
      "regex": "^/competitions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/competitions(?:/)?$"
    },
    {
      "page": "/competitions/new",
      "regex": "^/competitions/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/competitions/new(?:/)?$"
    },
    {
      "page": "/dach",
      "regex": "^/dach(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dach(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/leaderboard",
      "regex": "^/leaderboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/leaderboard(?:/)?$"
    },
    {
      "page": "/leaderboards",
      "regex": "^/leaderboards(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/leaderboards(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/matches",
      "regex": "^/matches(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/matches(?:/)?$"
    },
    {
      "page": "/moneyrace",
      "regex": "^/moneyrace(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/moneyrace(?:/)?$"
    },
    {
      "page": "/participants",
      "regex": "^/participants(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/participants(?:/)?$"
    },
    {
      "page": "/referrals",
      "regex": "^/referrals(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/referrals(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/telegram",
      "regex": "^/telegram(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/telegram(?:/)?$"
    },
    {
      "page": "/winners",
      "regex": "^/winners(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/winners(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}